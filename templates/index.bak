<!DOCTYPE html>
<html>
<head>
    <title>URL Shortener</title>
    <link rel="stylesheet" href="../static/style.css">
</head>
<body>

    <h1>URL Shortener</h1>

    <form method="POST">
        <input type="text" name="url" placeholder="Enter URL">
        <button type="submit">Shorten</button>
    </form>

    {% if short_url %}
        <p>Short URL:</p>
        <a href="{{ short_url }}">{{ short_url }}</a>
    {% endif %}

</body>
</html>
